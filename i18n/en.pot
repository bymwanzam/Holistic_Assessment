msgstr "Assessment is accurate and complete"

msgid ""
"The owner sees score suggestions and can accept or reject each one. "
"Accepted adjustments are applied."
msgstr ""
"The owner sees score suggestions and can accept or reject each one. "
"Accepted adjustments are applied."

msgid "Manual indicator values need correction"
msgstr "Manual indicator values need correction"

msgid ""
"The owner accepts the request to enter revision mode. Only flagged "
"indicators become editable, then they resubmit to the same reviewer."
msgstr ""
"The owner accepts the request to enter revision mode. Only flagged "
"indicators become editable, then they resubmit to the same reviewer."

msgid "Significant data quality issues"
msgstr "Significant data quality issues"

msgid ""
"The assessment is unlocked to Draft. The owner must substantially revise "
"and resubmit."
msgstr ""
"The assessment is unlocked to Draft. The owner must substantially revise "
"and resubmit."

msgid "Phase 4 — Response (owner)"
msgstr "Phase 4 — Response (owner)"

msgid ""
"Open the Peer Review page to see the reviewer comments, suggested "
"adjustments and recommendation."
msgstr ""
"Open the Peer Review page to see the reviewer comments, suggested "
"adjustments and recommendation."

msgid "For Approve — accept or reject individual score adjustments."
msgstr "For Approve — accept or reject individual score adjustments."

msgid ""
"For Request revision — accept the request, update the flagged indicators, "
"then resubmit."
msgstr ""
"For Request revision — accept the request, update the flagged indicators, "
"then resubmit."

msgid "For Reject — the assessment returns to Draft for a full revision."
msgstr "For Reject — the assessment returns to Draft for a full revision."

msgid ""
"Every indicator is scored from -2 to +2. The score depends on whether data "
"was supplied, whether the target was met, how performance changed since "
"last year, and how far performance sits from target."
msgstr ""
"Every indicator is scored from -2 to +2. The score depends on whether data "
"was supplied, whether the target was met, how performance changed since "
"last year, and how far performance sits from target."

